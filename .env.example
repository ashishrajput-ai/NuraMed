# ---- Frontend (safe to expose: public/anonymous values only) ----
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:4000

# ---- Server (NEVER expose these to the browser) ----
# InsForge managed PostgreSQL connection string (SSL required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/insforge?sslmode=require

# Server auth
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional InsForge HTTP API (only if you have an InsForge gateway URL + anon key)
INSFORGE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# Optional external providers (leave blank to run in clearly-labelled demo mode)
AI_PROVIDER_API_KEY=
AI_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
